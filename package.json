{
  "name": "fastapi-parking",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "backend\\.venv\\Scripts\\python -m uvicorn main:app --app-dir backend --reload --reload-dir backend --port 8000",
    "dev:web": "npm --prefix frontend run dev",
    "setup": "python -m venv backend\\.venv && backend\\.venv\\Scripts\\python -m pip install -r backend\\requirements.txt && npm --prefix frontend install"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
